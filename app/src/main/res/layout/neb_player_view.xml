<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared media3 PlayerView inflated by NebPlayerView. The crucial bit is
  surface_type="texture_view": the default SurfaceView races the decoder's
  first frame on attach (black stage with playing audio until a new surface
  appears — e.g. fullscreen). TextureView lives inside the view hierarchy,
  renders continuously, and plays well with Compose clipping/animation.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit" />
